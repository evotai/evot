{
 "schema_version": 1,
 "id": "secrets",
 "source": {
  "name": "magpie (internal/redact rules)",
  "url": "https://github.com/yetone/magpie",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 yetone"
 },
 "vars": {
  "PASSWORD_NAMES": "(?:password|passwd|passphrase)",
  "KEY_NAMES": "(?:secret|token|api[_-]?key|access[_-]?key|private[_-]?key|credential|client[_-]?secret|auth[_-]?key)",
  "CJK_PASSWORD": "@{cjk_password}",
  "CJK_KEY": "@{cjk_key}",
  "CJK_SEP": "[ \\t]*(?:[:：=][ \\t]*|[为為是][ \\t]*[:：]?[ \\t]*|は[ \\t]*|는[ \\t]*)?(?:\\\\?[\"'“「])?"
 },
 "lists": {
  "cjk_password": [
   "密码",
   "密碼",
   "口令",
   "pin码",
   "pin碼",
   "pin 码",
   "安全码",
   "安全碼",
   "パスワード",
   "暗証番号",
   "비밀번호",
   "암호",
   "비번"
  ],
  "cjk_key": [
   "密钥",
   "密鑰",
   "秘钥",
   "秘鑰",
   "私钥",
   "私鑰",
   "金钥",
   "金鑰",
   "令牌",
   "权杖",
   "權杖",
   "授权码",
   "授權碼",
   "秘密鍵",
   "トークン",
   "シークレット",
   "apiキー",
   "アクセスキー",
   "토큰",
   "비밀키",
   "api 키",
   "api키"
  ],
  "cjk_copulas": [
   "为",
   "為",
   "是",
   "："
  ],
  "quantity_units": [
   "位",
   "比特",
   "字节",
   "字節",
   "个",
   "個",
   "次",
   "秒",
   "毫秒",
   "分钟",
   "分鐘",
   "小时",
   "小時",
   "天",
   "年",
   "bit",
   "byte",
   "ms",
   "sec",
   "min",
   "ビット",
   "バイト",
   "비트",
   "바이트"
  ]
 },
 "checks": {
  "not_a_key_value": {
   "value": "^[A-Za-z_\\-./+=~!@#%^&*]{1,15}$"
  },
  "no_alnum": {
   "value": "^[^A-Za-z0-9]*$"
  },
  "short_number": {
   "value": "^[0-9]{1,5}$"
  },
  "symbols_and_digits": {
   "value": "^[^A-Za-z]*[^A-Za-z0-9][^A-Za-z]*$"
  },
  "a_quantity": {
   "value": "^[0-9]+$",
   "after": "^[ \\t]*(?:位|比特|字节|字節|个|個|次|秒|毫秒|分钟|分鐘|小时|小時|天|年|bit|byte|ms|sec|min|ビット|バイト|비트|바이트)"
  },
  "not_a_secret_name": {
   "before": "(?i)(?:_id|_url|_uri|_type|_name|_path|_file|_expires?(?:_at|_in)?|_ttl|_length|_len|_size|_count|_hash|_algorithm|_alg|_header|_prefix|_format|_endpoint)[\"']?[ \\t]*[:=][ \\t]*(?:\\\\?[\"'])?$"
  },
  "only_common_words": {
   "words": [
    "@{betterleaks_stopwords}"
   ]
  }
 },
 "rules": [
  {
   "id": "secrets.private-key",
   "kind": "PRIVATE_KEY",
   "confidence": "high",
   "regex": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----[\\s\\S]+?-----END (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----",
   "keywords": [
    "private key"
   ],
   "examples": {
    "matches": [
     "-----BEGIN RSA PRIVATE KEY-----\nDmKNJoJtif5b8SutiSmvP6g6KBIVQjvj877hS3vgxyj1admNL7sV5t3M8XmcBP0z\n-----END RSA PRIVATE KEY-----"
    ]
   }
  },
  {
   "id": "secrets.sk-key",
   "kind": "API_KEY",
   "confidence": "high",
   "regex": "sk-(?:ant-|proj-|or-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}",
   "keywords": [
    "sk-"
   ],
   "bound": "${TOKEN_BOUND}",
   "examples": {
    "matches": [
     "key sk-proj-dsZhPyK4aL5zkp6gyFh3wzPelXSJn8ADkbpS9xmS"
    ],
    "ignores": [
     "task-sk-short",
     "disk-usage-report-for-the-quarter"
    ]
   }
  },
  {
   "id": "secrets.prefixed-sk",
   "kind": "API_KEY",
   "regex": "[a-z]{2,4}_sk_[A-Za-z0-9_-]{20,}",
   "keywords": [
    "_sk_"
   ],
   "bound": "${TOKEN_BOUND}",
   "unless": [
    "a_variable",
    "an_env_read",
    "no_digit_and_letter"
   ],
   "examples": {
    "matches": [
     "oc_sk_OC19vLrb9zUYePjfvTgHqyd5"
    ]
   }
  },
  {
   "id": "secrets.github-classic",
   "kind": "TOKEN",
   "regex": "gh[pousr]_[A-Za-z0-9]{36}",
   "keywords": [
    "ghp_",
    "gho_",
    "ghu_",
    "ghs_",
    "ghr_"
   ],
   "bound": "${TOKEN_BOUND}",
   "checksum": {
    "algorithm": "crc32_base62",
    "keep_on_fail": true,
    "confirmed": "high"
   },
   "examples": {
    "matches": [
     "ghp_rUncVdfHJKl5pH4eCvf69ZVyUBUTmcdMeidi"
    ]
   }
  },
  {
   "id": "secrets.github-other",
   "kind": "TOKEN",
   "confidence": "high",
   "regex": "(?:github_pat_[A-Za-z0-9_]{40,}|glpat-[A-Za-z0-9_-]{20,})",
   "keywords": [
    "github_pat_",
    "glpat-"
   ],
   "bound": "${TOKEN_BOUND}",
   "examples": {
    "matches": [
     "github_pat_AuNZ40t5VNUKj0w5fihpaJqo3QRrJ7B6SOWMZ7XNBVpTfB0GlAASJHfa2Bkh"
    ]
   }
  },
  {
   "id": "secrets.npm",
   "kind": "TOKEN",
   "regex": "npm_[A-Za-z0-9]{36}",
   "keywords": [
    "npm_"
   ],
   "bound": "${TOKEN_BOUND}",
   "checksum": {
    "algorithm": "crc32_base62",
    "keep_on_fail": true,
    "confirmed": "high"
   },
   "examples": {
    "matches": [
     "npm_6mLsOZ1Si4GyycnimuyPjOhZdq9I9ZmjXawQ"
    ]
   }
  },
  {
   "id": "secrets.vendor-prefixed",
   "kind": "API_KEY",
   "confidence": "high",
   "regex": "(?:AIza[0-9A-Za-z_-]{35}|(?:sk|rk)_live_[0-9A-Za-z]{20,}|hf_[A-Za-z0-9]{30,}|gsk_[A-Za-z0-9]{40,}|xai-[A-Za-z0-9]{40,}|pypi-[A-Za-z0-9_-]{50,}|dop_v1_[a-f0-9]{64}|SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43})",
   "keywords": [
    "aiza",
    "_live_",
    "hf_",
    "gsk_",
    "xai-",
    "pypi-",
    "dop_v1_",
    "sg."
   ],
   "bound": "${TOKEN_BOUND}",
   "examples": {
    "matches": [
     "AIzamIAYBzuoJIlpARuZ9iZgUf9lDlB3OZuMbjb",
     "hf_VeIz2FI9BHxPrU0iigW0yUzPdfTPb8JAzS"
    ]
   }
  },
  {
   "id": "secrets.aws-key-id",
   "kind": "API_KEY",
   "confidence": "high",
   "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}",
   "keywords": [
    "akia",
    "asia"
   ],
   "bound": "[A-Za-z0-9]",
   "examples": {
    "matches": [
     "AKIAIOSFODNN7EXAMPLE"
    ],
    "ignores": [
     "AKIAshort"
    ]
   }
  },
  {
   "id": "secrets.jwt",
   "kind": "TOKEN",
   "confidence": "high",
   "regex": "eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
   "keywords": [
    "eyj"
   ],
   "bound": "${TOKEN_BOUND}",
   "examples": {
    "matches": [
     "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0ZXN0In0.XWLUPV89QY34OHEXVeoqIR"
    ]
   }
  },
  {
   "id": "secrets.bearer",
   "kind": "TOKEN",
   "regex": "(?i)\\bbearer[ \\t]+([A-Za-z0-9_\\-.~+/]{16,}=*)",
   "keywords": [
    "bearer"
   ],
   "unless": [
    "a_variable",
    "an_env_read",
    "no_digit_and_letter"
   ],
   "examples": {
    "matches": [
     "Authorization: Bearer 1k86lqepm9VtVs6PKOKotOiYnSvcnGmQ"
    ],
    "ignores": [
     "Bearer authentication is described here"
    ]
   }
  },
  {
   "id": "secrets.basic-auth",
   "kind": "TOKEN",
   "regex": "(?i)\\bbasic[ \\t]+([A-Za-z0-9+/]{8,}={0,2})(?:[^A-Za-z0-9+/=]|$)",
   "keywords": [
    "basic "
   ],
   "unless": [
    "a_variable",
    {
     "value": "^[a-z]+$"
    }
   ],
   "examples": {
    "matches": [
     "Authorization: Basic dXNlcjpwYXNzd29yZA=="
    ],
    "ignores": [
     "basic usage"
    ]
   }
  },
  {
   "id": "secrets.url-password",
   "kind": "PASSWORD",
   "regex": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s:@/?#\"'<>]*:([^\\s@/?#\"'<>]{3,})@",
   "keywords": [
    "://"
   ],
   "unless": [
    "a_variable"
   ],
   "examples": {
    "matches": [
     "postgres://app:s3cretpw@db.internal:5432/x"
    ],
    "ignores": [
     "postgres://app:${DB_PASS}@db/x",
     "https://host:8080/path"
    ]
   }
  },
  {
   "id": "secrets.password-assignment",
   "kind": "PASSWORD",
   "regex": "(?i)[A-Za-z0-9_.-]*${PASSWORD_NAMES}[A-Za-z0-9_.-]*${QUOTE}[ \\t]*[:=][ \\t]*${QUOTE}(${SECRET_CH}{6,})",
   "keywords": [
    "pass"
   ],
   "unless": [
    "a_variable",
    "an_env_read",
    "code_name",
    "code_type",
    "not_a_secret_name",
    {
     "value": "^(?i:true|false|null|none|required|optional|string)$"
    }
   ],
   "examples": {
    "matches": [
     "DB_PASSWORD=xPXUGoKipjNH6Y",
     "\"password\": \"2xcAzQ51TANH\""
    ],
    "ignores": [
     "password: string;",
     "password_hash: 0123456789abcdef0123456789abcdef01234567",
     "password = getPassword()"
    ]
   }
  },
  {
   "id": "secrets.key-assignment",
   "kind": "SECRET",
   "regex": "(?i)[A-Za-z0-9_.-]*${KEY_NAMES}[A-Za-z0-9_.-]*${QUOTE}[ \\t]*[:=][ \\t]*${QUOTE}(${SECRET_CH}{8,})",
   "keywords": [
    "secret",
    "token",
    "key",
    "credential"
   ],
   "unless": [
    "a_variable",
    "an_env_read",
    "no_digit_and_letter",
    "code_name",
    "code_type",
    "not_a_secret_name",
    "only_common_words",
    "a_placeholder",
    "low_entropy"
   ],
   "examples": {
    "matches": [
     "STRIPE_SECRET=DX9IhicYAMZHGHJdupnZBiMV",
     "\"apiKey\": \"52MnJAPCjFjxJeDdTKluQdsc9a39UlP0\"",
     "access_token = fIPXtxgNFmHZz8t86abZ6P4bW1sI"
    ],
    "ignores": [
     "max_tokens: 12345678",
     "token = process.env.TOKEN_42",
     "secretKey: Uint8Array;",
     "api_key_id = m6PuYWDFL9rW7UAZyfO4",
     "token_url: https://a.b/c2",
     "apiKey: your_api_key_here",
     "access_token: changeme"
    ]
   }
  },
  {
   "id": "secrets.bare-key-field",
   "kind": "SECRET",
   "regex": "(?i)(?:^|[^A-Za-z0-9_.-])${QUOTE}key${QUOTE}[ \\t]*[:=][ \\t]*${QUOTE}(${SECRET_CH}{16,})",
   "keywords": [
    "key"
   ],
   "unless": [
    "a_variable",
    "an_env_read",
    "no_digit_and_letter",
    "code_name",
    "code_type",
    "a_placeholder"
   ],
   "examples": {
    "matches": [
     "\"key\": \"nW9hHc6CQSi78EAZTg4GGZearay4HjbU\""
    ],
    "ignores": [
     "\"key\": \"user_profile_settings\""
    ]
   }
  },
  {
   "id": "secrets.cjk-password",
   "kind": "PASSWORD",
   "regex": "(?i)${CJK_PASSWORD}${CJK_SEP}(${SECRET_CH}{3,63}${SECRET_END})",
   "keywords": [
    "@{cjk_password}"
   ],
   "unless": [
    "a_variable"
   ],
   "examples": {
    "matches": [
     "密码：5bwPkEzStk99",
     "パスワードは m1ZgdLVPuRRP"
    ]
   }
  },
  {
   "id": "secrets.cjk-key",
   "kind": "SECRET",
   "regex": "(?i)${CJK_KEY}${CJK_SEP}(${SECRET_CH}{3,63}${SECRET_END})",
   "keywords": [
    "@{cjk_key}"
   ],
   "unless": [
    "a_variable",
    "not_a_key_value",
    "no_alnum",
    "short_number",
    "symbols_and_digits",
    "a_quantity"
   ],
   "examples": {
    "matches": [
     "密钥为zRKW4noXRRLPVOm4wjkRhDlo",
     "令牌：XXIambvPVmG45Gww0lc5"
    ],
    "ignores": [
     "密钥为 2048 位",
     "令牌：abc"
    ]
   }
  },
  {
   "id": "secrets.copula-key",
   "kind": "SECRET",
   "regex": "(?i)(?:${PASSWORD_NAMES}|${KEY_NAMES}|pwd|api[ ]key|access[ ]key|secret[ ]key|key|\\bpin(?:[ ]?code)?)${QUOTE}[ \\t]*(?:[为為是][ \\t]*[:：]?|：)[ \\t]*(?:\\\\?[\"'“「])?(${SECRET_CH}{3,}${SECRET_END})",
   "keywords": [
    "@{cjk_copulas}"
   ],
   "unless": [
    "a_variable",
    "not_a_key_value",
    "no_alnum",
    "short_number",
    "symbols_and_digits",
    "a_quantity"
   ],
   "examples": {
    "matches": [
     "apikey 为 Hcl8Nh1i0g08t4blYyXQaIl6",
     "API Key：GO3vNyqn5tIgGutvxMJprCib"
    ],
    "ignores": [
     "token 是 2048 位"
    ]
   }
  }
 ]
}
