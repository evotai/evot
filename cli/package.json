{
  "name": "@evotai/evot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "evot": "./bin/evot"
  },
  "napi": {
    "binaryName": "evot-napi",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:napi": "napi build --manifest-path addon/Cargo.toml --output-dir . --release --platform --no-js && bun scripts/check-native.ts",
    "build:cli": "bun build src/index.ts --compile --define process.env.DEV='\"false\"' --define process.env.NODE_ENV='\"production\"' --outfile dist/evot && mkdir -p dist/lib && cp evot-napi.*.node dist/lib/",
    "dev": "bun run src/index.ts",
    "test": "bun test tests/ --path-ignore-patterns 'tests/tui/**'",
    "test:tui": "bun test tests/tui/",
    "preview:tui": "bun scripts/preview-tui.ts",
    "trace:renderer": "bun scripts/analyze-renderer-trace.ts"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "get-east-asian-width": "^1.5.0",
    "mac-system-proxy": "1.0.4",
    "marked": "^15.0.0",
    "partial-json": "0.1.7",
    "proxy-from-env": "2.1.0",
    "string-width": "^8.2.0",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.1",
    "@types/bun": "^1.2.0",
    "@types/diff": "^8.0.0",
    "@types/proxy-from-env": "1.0.4",
    "@xterm/headless": "5.5.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "ansi-styles": "^4.3.0"
  }
}
